<u:BoundViewBase x:Class="ScriptScripter.DesktopApp.Views.SelectScriptContainerView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:u="clr-namespace:ScriptScripter.DesktopApp"
                 xmlns:local="clr-namespace:ScriptScripter.DesktopApp.Views"
                 mc:Ignorable="d"
                 xmlns:designViewModel="clr-namespace:ScriptScripter.DesktopApp.ViewModels"
                 d:DataContext ="{d:DesignInstance {x:Type designViewModel:SelectScriptContainerViewModel}, IsDesignTimeCreatable=True}"
                 d:DesignHeight="250" d:DesignWidth="350" InitialDialogWidth="350" InitialDialogHeight="400"
                 x:Name="root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="More than one script container matches. Select which one to use:" Margin="5" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ContainerOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectContainerCommand, ElementName=root}"
                                CommandParameter="{Binding}"
                                HorizontalContentAlignment="Stretch"
                                Margin="5" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding DatabaseName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CustomServerConnectionParameters, TargetNullValue='(default connection)'}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Cancel" Width="100" IsCancel="True" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</u:BoundViewBase>
